import aspersor.*
import cultivos.*
import factory.*
import wollok.game.*
import mercado.*
import personaje.*

describe "Ventas de plantas"{
    method initialize() {
            
        personaje.position(game.at(5,5 ))
        game.addVisual(personaje)
        assert.equals(0, personaje.oroActual())
        assert.equals([], personaje.cosecha())
        const mercado = new Mercado(position = game.at(6,6),cantidadMonedas=500)
        game.addVisual(mercado)
   }
    test "Venta de maiz"{
        const maiz = new Maiz(position=game.at(5,5), estadoMaiz = maizAdulto)
        game.addVisual(maiz)
        personaje.cosechar()
        assert.equals([maiz], personaje.cosecha())
        personaje.position(game.at(6,6))
        personaje.venderCosecha()
        assert.equals([], personaje.cosecha())
        assert.equals(150, personaje.oroActual())
        // no me deja verificar la plata del mercado
        //assert.equals(350, mercado.cantidadMonedas())
    }
    test "Venta de trigo"{
        const trigo = new Trigo (position=game.at(5,5), etapa=2)
        game.addVisual(trigo)
        personaje.cosechar()
        assert.equals([trigo], personaje.cosecha())
        personaje.position(game.at(6,6))
        personaje.venderCosecha()
        assert.equals([], personaje.cosecha())
        assert.equals(100, personaje.oroActual())
    }

    test "Venta de tomaco"{
        const tomaco = new Tomaco(position=game.at(5,5))
        game.addVisual(tomaco)
        personaje.cosechar()
        assert.equals([tomaco], personaje.cosecha())
        personaje.position(game.at(6,6))
        personaje.venderCosecha()
        assert.equals([], personaje.cosecha())
        assert.equals(80, personaje.oroActual())
    }
}
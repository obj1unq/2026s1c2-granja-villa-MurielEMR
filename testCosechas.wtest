import aspersor.*
import cultivos.*
import factory.*
import wollok.game.*
import mercado.*
import personaje.*

describe "Cosechas de plantas"{
    test "Cosecha de maiz"{
        personaje.position(game.at(5,5 ))
        const maiz = new Maiz(position=game.at(5,5), estadoMaiz = maizAdulto)
        game.addVisual(maiz)
        assert.equals(game.at(5,5), maiz.position())
        personaje.cosechar()
        const plantaCosechada = game.colliders(personaje).findOrDefault({ obj => obj.esCultivo() }, null)
        assert.equals(null, plantaCosechada)
    }
    test "Cosecha de trigo"{
        personaje.position(game.at(5,5 ))
        const trigo = new Trigo(position=game.at(5,5), etapa = 2)
        game.addVisual(trigo)
        assert.equals(game.at(5,5), trigo.position())
        personaje.cosechar()
        const plantaCosechada = game.colliders(personaje).findOrDefault({ obj => obj.esCultivo() }, null)
        assert.equals(null, plantaCosechada)
    }

    test "Cosecha de tomaco"{
        personaje.position(game.at(5,5 ))
        const tomaco = new Tomaco(position=game.at(5,5))
        game.addVisual(tomaco)
        assert.equals(game.at(5,5), tomaco.position())
        personaje.cosechar()
        const plantaCosechada = game.colliders(personaje).findOrDefault({ obj => obj.esCultivo() }, null)
        assert.equals(null, plantaCosechada)
    }
}